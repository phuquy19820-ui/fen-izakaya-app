# ============================================
# FEN IZAKAYA - PURCHASING SYSTEM CONFIG
# ============================================

# DATABASE CONNECTION
# For Neon.tech: postgresql://user:password@host/database
# For Local PostgreSQL: postgresql://postgres:password@localhost:5432/fen_izakaya
DATABASE_URL=postgresql://username:password@localhost:5432/fen_izakaya_db

# SERVER SETTINGS
PORT=5000
NODE_ENV=development

# CUKCUK API INTEGRATION
CUKCUK_API_URL=https://openapi.cukcuk.vn/api/v1

# Application Settings
APP_NAME=Fen Izakaya Purchase Planning
APP_VERSION=1.0.0

# File Upload Settings
MAX_FILE_SIZE=52428800

# CORS Settings (for frontend domain)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
